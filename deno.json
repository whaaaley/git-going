{
  "name": "@whaaaley/git-going",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./src/main.ts",
    "./validator": "./src/commit.validator.ts",
    "./check": "./src/uncommitted.check.ts",
    "./tier": "./src/treesize.tier.ts",
    "./config": "./src/config.ts"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      ".zed/",
      ".github/",
      "SKILL.md"
    ]
  },
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check": "deno check .",
    "test": "deno test -A",
    "test:node": "node --test 'src/**/*.test.ts'",
    "test:bun": "bun test src/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "lint": {
    "rules": {
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-explicit-any",
        "no-non-null-assertion"
      ]
    }
  },
  "fmt": {
    "lineWidth": 240,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "*.md",
      "**/*.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/path": "jsr:@std/path@^1.1.6"
  }
}
